{
  "name": "chosen-logistics",
  "version": "1.0.0",
  "private": true,
  "description": "Chosen Logistics Ltd - co-loading cargo & freight website with built-in CMS",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"PORT=${API_PORT:-4000} node --watch --env-file-if-exists=.env server/index.js\" \"vite\"",
    "dev:api": "PORT=${API_PORT:-4000} node --watch --env-file-if-exists=.env server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "reset-admin": "node --env-file-if-exists=.env server/reset-admin.js",
    "deploy": "bash scripts/deploy-railway.sh"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  }
}
