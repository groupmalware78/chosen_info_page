# Copy to .env and adjust. All values are optional except where noted for production.

PORT=3000

# First-run admin account. If ADMIN_PASSWORD is empty, a random password is generated
# and printed to the console on first start. Change it from Admin → Account after signing in.
ADMIN_EMAIL=admin@chosenlogistics.com
ADMIN_PASSWORD=Password1##

# Where the SQLite database and uploaded images are stored. Back this folder up.
DATA_DIR=./data

# Set to 1 when behind a reverse proxy / load balancer (nginx, Render, Fly.io, Railway…)
# so rate limiting and secure cookies see the real client IP and protocol.
TRUST_PROXY=1

# Secure cookies require HTTPS. Defaults to true in production. Set false only for local http testing.
# COOKIE_SECURE=true

SESSION_DAYS=7

# Optional: email a notification for every contact-form enquiry.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Chosen Logistics Website <no-reply@chosenlogistics.com>"
# Defaults to the company email set in Admin → Company & SEO
CONTACT_NOTIFY_TO=
